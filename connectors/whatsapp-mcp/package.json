{
  "name": "whatsapp-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP connector that lets Claude send/read WhatsApp messages via whatsapp-web.js (no WhatsApp Business API required — links like a normal linked device).",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.19.2",
    "patch-package": "^8.0.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}

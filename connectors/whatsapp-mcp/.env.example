# --- Where this connector listens ---
PORT=8788

# --- Bearer token every Claude client (and the /qr, /status pages) must send.
#     Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CONNECTOR_AUTH_TOKEN=

# --- Where the linked-device session is persisted so you don't have to
#     rescan the QR code on every restart. Point this at a persistent volume.
WHATSAPP_SESSION_PATH=./session

# --- Only needed if you want to use a system-installed Chromium instead of
#     the one puppeteer downloads for itself (the Docker image sets this
#     automatically to /usr/bin/chromium).
# PUPPETEER_EXECUTABLE_PATH=

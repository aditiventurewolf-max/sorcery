# --- Where this connector listens ---
PORT=8787

# --- Bearer token every Claude client must send. Generate with:
#     node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CONNECTOR_AUTH_TOKEN=

# --- Your Metabase instance ---
METABASE_URL=https://metabase.example.com

# Option A (no API key needed — a normal Metabase login):
METABASE_USERNAME=you@example.com
METABASE_PASSWORD=your-metabase-password

# Option B (Metabase 0.49+ Admin > API Keys) — set this instead of the two above
# and leave USERNAME/PASSWORD blank.
# METABASE_API_KEY=
